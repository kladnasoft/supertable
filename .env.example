# Local development template. Supply every credential through a secret manager
# or an untracked .env; never commit live tokens or storage keys.
SUPERTABLE_HOME=/app/supertable
SUPERTABLE_ORGANIZATION=example-org
SUPERTABLE_SUPERUSER_TOKEN=replace-with-secret-manager-reference
SUPERTABLE_LOGIN_MASK=1

STORAGE_TYPE=minio
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_SPARK_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=replace-with-secret-manager-reference
STORAGE_SECRET_KEY=replace-with-secret-manager-reference
STORAGE_BUCKET=supertable
STORAGE_FORCE_PATH_STYLE=true

LOCKING_BACKEND=redis
SUPERTABLE_REDIS_DB=0
SUPERTABLE_REDIS_SENTINEL=false
SUPERTABLE_REDIS_SENTINELS=
SUPERTABLE_REDIS_SENTINEL_MASTER=
SUPERTABLE_REDIS_SENTINEL_PASSWORD=replace-with-secret-manager-reference

DUCKDB_JE_MALLOC_CONF=background_thread:true
SUPERTABLE_DUCKDB_PRESIGNED=false
SUPERTABLE_DUCKDB_HTTP_TIMEOUT=60
SUPERTABLE_DUCKDB_HTTP_METADATA_CACHE=true
SUPERTABLE_DUCKDB_MEMORY_LIMIT=1GB
SUPERTABLE_DUCKDB_IO_MULTIPLIER=3
SUPERTABLE_DUCKDB_EXTERNAL_CACHE_SIZE=1GB
SUPERTABLE_DUCKDB_ENGINE_CACHE_MAX_ENTRIES=16
SUPERTABLE_DUCKDB_EXTERNAL_CACHE_DIR=/app/supertable/duckdb_cache
SUPERTABLE_PRESIGN_EXPIRY_MARGIN_SEC=120
SUPERTABLE_PRESIGN_MAX_EXPIRY_SEC=604200
SUPERTABLE_RESULT_STREAM_BATCH_ROWS=256
SUPERTABLE_RESULT_STREAM_BATCH_BYTES=4194304
SUPERTABLE_RESULT_STREAM_VARIABLE_FETCH_ROWS=16
SUPERTABLE_ISLAND_SPILL_DIR=/app/supertable/island_spill
SUPERTABLE_ISLAND_SPILL_MAX_BYTES=8589934592
SUPERTABLE_ISLAND_SPILL_MIN_FREE_BYTES=536870912

SUPERTABLE_API_HOST=127.0.0.1
SUPERTABLE_API_PORT=8050
SUPERTABLE_UI_HOST=127.0.0.1
SUPERTABLE_UI_PORT=8051
SUPERTABLE_ODATA_HOST=127.0.0.1
SUPERTABLE_ODATA_PORT=8052
SUPERTABLE_MCP_PORT=8053
SUPERTABLE_MCP_TRANSPORT=streamable-http
SUPERTABLE_REQUIRE_TOKEN=true
SUPERTABLE_MCP_TOKEN=replace-with-secret-manager-reference

SUPERTABLE_LOG_LEVEL=INFO
SUPERTABLE_LOG_FORMAT=json
SUPERTABLE_CORRELATION_HEADER=X-Correlation-ID
SUPERTABLE_AUTH_MODE=bearer
SUPERTABLE_API_KEY=replace-with-secret-manager-reference
SUPERTABLE_AUTH_HEADER_NAME=Authorization
